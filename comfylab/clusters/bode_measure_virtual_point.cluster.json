        "id": "block_acq_ch2",
        "type": "devices/virtual/oscilloscope/acquire",
        "properties": {
          "Channel": 2
        },
        "position": {
          "x": 1800,
          "y": 100
        }
      },
      {
        "id": "block_calc_gain",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"ch1\" type=\"ndarray\"\n# @input name=\"ch2\" type=\"ndarray\"\n# @input name=\"freq\" type=\"number\"\n# @output name=\"gain_db\" type=\"number\"\n# @output name=\"vpp_in\" type=\"number\"\n# @output name=\"vpp_out\" type=\"number\"\n\nimport numpy as np\n\nv_in = float(np.ptp(ch1)) if len(ch1) > 0 else 1.0\nv_out = float(np.ptp(ch2)) if len(ch2) > 0 else 0.0\n\nvpp_in = v_in\nvpp_out = v_out\nratio = max(v_out / max(v_in, 1e-6), 1e-6)\ngain_db = float(20.0 * np.log10(ratio))\n",
          "customInputs": [
            {
              "name": "ch1",
              "type": "ndarray"
            },
            {
              "name": "ch2",
              "type": "ndarray"
            },
            {
              "name": "freq",
              "type": "number"
            }
          ],
          "customOutputs": [
            {
              "name": "gain_db",
              "type": "number"
            },
            {
              "name": "vpp_in",
              "type": "number"
            },
            {
              "name": "vpp_out",
              "type": "number"
            }
          ]
        },
        "position": {
          "x": 2100,
          "y": 100
        }
      },
