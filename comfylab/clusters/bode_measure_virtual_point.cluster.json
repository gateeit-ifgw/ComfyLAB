        "id": "block_osc_timebase",
        "type": "devices/virtual/oscilloscope/timebase",
        "properties": {
          "Scale": 0.001,
          "Offset": 0.0,
          "Points": 1000
        },
        "position": {
          "x": 900,
          "y": 100
        }
      },
