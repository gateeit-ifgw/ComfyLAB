        "id": "block_calc_timebase",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"freq\" type=\"number\" default=1000.0\n# @output name=\"scale\" type=\"number\"\n\n# Auto-adjust oscilloscope horizontal timebase scale (s/div)\nscale = max(1e-9, 0.2 / max(float(freq), 1.0))\n",
          "customInputs": [
            {
              "name": "freq",
              "type": "number",
              "default": 1000
            }
          ],
          "customOutputs": [
            {
              "name": "scale",
              "type": "number"
            }
          ]
        },
        "position": {
          "x": 600,
          "y": 100
        }
      },
